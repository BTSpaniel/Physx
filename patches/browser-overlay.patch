+
+        virtual physx::PxReal getMargin() const {
+            CustomSupport* nonConst = (CustomSupport*) this;
+            return nonConst->getCustomMargin();
+        }
+
+        virtual physx::PxVec3 supportLocal(const physx::PxVec3& dir) const {
