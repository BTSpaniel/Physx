+struct DirectDrivetrainState
+{
+	PxReal directDriveThrottleResponseStates[PxVehicleLimits::eMAX_NB_WHEELS];
+
+	PX_FORCE_INLINE void setToDefault()
+	{
+		PxMemZero(this, sizeof(DirectDrivetrainState));
+	}
+};
