+)
+
+SET(PHYSX_JNIBINDINGS_COMPILE_DEFS
+	# Common to all configurations
+	${PHYSX_LINUX_COMPILE_DEFS};PX_JNIBINDINGS;${PXJNIBINDINGS_LIBTYPE_DEFS}
