diff --git a/physx/source/webidlbindings/src/wasm/onload.js b/physx/source/webidlbindings/src/wasm/onload.js
new file mode 100644
index 00000000..cb98ab68
--- /dev/null
+++ b/physx/source/webidlbindings/src/wasm/onload.js
@@ -0,0 +1,53 @@
+/**
+ * Makes the API a little less verbose
+ */
+Object.defineProperty(Module, 'PHYSICS_VERSION', { get() { return Module.PxTopLevelFunctions.prototype.PHYSICS_VERSION; }});
+
+//Move PxTopLevelFunctions to PhysX object
+for(const prop in Module.PxTopLevelFunctions.prototype) {
+    if(prop !== 'constructor' && !prop.startsWith('get_') && !prop.startsWith('__')) {
+        Object.defineProperty(Module, prop, { get() { return Module.PxTopLevelFunctions.prototype[prop]; }});
+    }
+}
+
+//Move NativeArrayHelpers to PhysX object
+for(const prop in Module.NativeArrayHelpers.prototype) {
+    if(prop !== 'constructor' && !prop.startsWith('get_') && !prop.startsWith('__')) {
+        Object.defineProperty(Module, prop, { get() { return Module.NativeArrayHelpers.prototype[prop]; }});
+    }
+}
+
+//Group enums
+const regex = /_emscripten_enum_(.*?)_(.*)/;
+const enums = Object.keys(Module).filter(key => key.includes('_emscripten_enum_')).map(emscript => emscript.match(regex));
+
+for (const [emscript, enumName, entryName] of enums) {
+    Module[enumName] ??= {};
+    Object.defineProperty(Module[enumName], entryName, { get() { return Module[emscript](); }});
+}
+// PR_PHYSX_510_ACTOR_ALIAS_V1
+// Append after fabmax onload.js. These are aliases for a renamed actor type,
+// NOT CPU implementations of CUDA-only deformables.
+(function () {
+    const actorTypes = Module['PxActorTypeEnum'];
+    if (!actorTypes || !Object.prototype.hasOwnProperty.call(actorTypes, 'eDEFORMABLE_VOLUME') ||
+        typeof Module['_emscripten_enum_PxActorTypeEnum_eDEFORMABLE_VOLUME'] !== 'function') {
+        throw new Error('PhysX 5.10 port: expected deformable-volume actor enum is missing');
+    }
+    if (Object.prototype.hasOwnProperty.call(actorTypes, 'eSOFTBODY')) {
+        throw new Error('PhysX 5.10 port: duplicate legacy actor alias');
+    }
+    Object.defineProperty(actorTypes, 'eSOFTBODY', {
+        enumerable: true,
+        get: function () { return actorTypes['eDEFORMABLE_VOLUME']; }
+    });
+    // The raw generated enum function and collapsed top-level name also existed
+    // in the previous loader. Keep their exact equivalent without reviving a
+    // removed native C++ enum declaration.
+    Module['_emscripten_enum_PxActorTypeEnum_eSOFTBODY'] =
+        Module['_emscripten_enum_PxActorTypeEnum_eDEFORMABLE_VOLUME'];
+    Object.defineProperty(Module, 'eSOFTBODY', {
+        enumerable: true,
+        get: function () { return actorTypes['eDEFORMABLE_VOLUME']; }
+    });
+})();
